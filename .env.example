# Servidor
PORT=3000
BASE_URL=https://iadojeitocerto.com
NODE_ENV=production

# Banco (volume persistente no Coolify em /app/data)
DB_PATH=/app/data/t4p.db

# Proxies à frente do app (Cloudflare → Traefik)
TRUST_PROXY=2

# Mercado Pago — aplicação "T4P" (NÃO usar credenciais do Orbinote)
MP_ACCESS_TOKEN=
MP_WEBHOOK_SECRET=
# URL base da API do MP; deixe em branco em produção. Em teste local, aponte para o mp-fake (scripts/mp-fake.js).
MP_API_URL=

# Preço de lançamento em reais, válido até 25/09 (use 1.00 só no teste real de ponta a ponta)
PRECO=49.90

# Admin (/admin)
ADMIN_USER=
ADMIN_PASS=
