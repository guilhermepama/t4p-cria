# Servidor
PORT=3000
BASE_URL=https://iadojeitocerto.com
NODE_ENV=production

# Banco (volume persistente no Coolify em /app/data)
DB_PATH=/app/data/t4p.db

# Sessão (string aleatória longa: openssl rand -hex 32)
SESSION_SECRET=

# Mercado Pago — aplicação "T4P" (NÃO usar credenciais do Orbinote)
MP_ACCESS_TOKEN=
MP_WEBHOOK_SECRET=

# Preço em reais (use 1.00 só no teste real de ponta a ponta)
PRECO=97.00

# Admin (/admin)
ADMIN_USER=
ADMIN_PASS=
